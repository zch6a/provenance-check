{
  "manifest_version": 3,
  "name": "provenance-check",
  "version": "0.1.0",
  "description": "Check an image's Content Credentials (C2PA): who signed it, with what, whether AI was used, and whether it changed since. Read on your computer; nothing is uploaded.",
  "minimum_chrome_version": "116",
  "permissions": ["contextMenus"],
  "optional_host_permissions": ["*://*/*"],
  "incognito": "split",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "provenance-check", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" }
}
