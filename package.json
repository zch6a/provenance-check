{
  "name": "provenance-check",
  "version": "0.6.0",
  "private": true,
  "description": "Check an image's Content Credentials (C2PA) on your computer: who signed it, with what, whether AI was used, and whether it changed since. A browser extension and a command line. Nothing is uploaded.",
  "keywords": [
    "c2pa",
    "content-credentials",
    "provenance",
    "browser-extension",
    "ai-generated",
    "image-verification"
  ],
  "license": "MIT",
  "author": "zch6a",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zch6a/provenance-check.git"
  },
  "type": "module",
  "bin": {
    "provenance-check": "src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check": "tsc --noEmit -p jsconfig.json",
    "fixtures": "node scripts/make-fixtures.mjs",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "@contentauth/c2pa-wasm": "0.13.4",
    "@contentauth/c2pa-web": "0.15.5"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
