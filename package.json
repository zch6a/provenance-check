{
  "name": "provenance-check",
  "version": "0.1.0",
  "private": true,
  "description": "A browser extension that checks an image's Content Credentials (C2PA) on your computer: who signed it, with what, whether AI was used, and whether it changed since. Nothing is uploaded.",
  "keywords": ["c2pa", "content-credentials", "provenance", "browser-extension", "ai-generated", "image-verification"],
  "license": "MIT",
  "author": "zch6a",
  "repository": { "type": "git", "url": "git+https://github.com/zch6a/provenance-check.git" },
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check": "tsc --noEmit -p jsconfig.json",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "dependencies": {
    "@contentauth/c2pa-web": "0.15.5"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
